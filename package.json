{
  "name": "soostori-desktop",
  "version": "1.0.0",
  "description": "Soostori POS + Inventory Desktop App (Electron)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev --config electron-vite.config.mjs",
    "build": "node node_modules/electron-vite/bin/electron-vite.js build --config electron-vite.config.mjs",
    "preview": "node node_modules/electron-vite/bin/electron-vite.js preview --config electron-vite.config.mjs",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-builder --win --config electron-builder.yml",
    "package:dir": "electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "@soostori/audit": "0.1.0-alpha.1",
    "@soostori/auth": "0.1.0-alpha.3",
    "@soostori/business": "workspace:*",
    "@soostori/cloud": "0.1.0-alpha.1",
    "@soostori/core": "workspace:*",
    "@soostori/customers": "0.1.0-alpha.1",
    "@soostori/debts": "0.1.0-alpha.1",
    "@soostori/desktop-adapter": "workspace:*",
    "@soostori/devices": "workspace:*",
    "@soostori/events": "workspace:*",
    "@soostori/inventory": "workspace:*",
    "@soostori/notifications": "0.1.0-alpha.1",
    "@soostori/offline": "0.1.0-alpha.1",
    "@soostori/products": "0.1.0-alpha.1",
    "@soostori/sales": "0.1.0-alpha.1",
    "@soostori/storage": "^0.1.0-alpha.1",
    "@soostori/subscription": "0.1.0-alpha.1",
    "@tanstack/react-query": "^5.62.0",
    "atomically": "^2.1.1",
    "better-sqlite3": "11.10.0",
    "clsx": "^2.1.1",
    "conf": "^15.1.0",
    "dot-prop": "^10.2.0",
    "electron-log": "^5.2.4",
    "electron-store": "8.1.0",
    "electron-updater": "^6.8.9",
    "env-paths": "^4.0.0",
    "json-schema-typed": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.0",
    "semver": "^7.8.5",
    "serialport": "^12.0.0",
    "uuid": "^11.0.3",
    "v8-compile-cache-lib": "^3.0.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "author": "Soostori Technologies <support@soostori.com>",
  "build": {
    "extends": "electron-builder.yml"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "better-sqlite3",
      "electron"
    ]
  }
}
